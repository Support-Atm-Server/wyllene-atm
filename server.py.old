app = Flask(__name__)


@app.route('/dashboard')
def unified_dashboard():
    import market_economy
    economy = market_economy.economy
    market = economy.generate_market_year()
    stocks = economy.get_stock_prices()
    leaderboard = economy.update_leaderboard()
    total_dynasties = len(leaderboard)
    total_wealth = sum(d['wealth'] for d in leaderboard)
    total_members = sum(d['members'] for d in leaderboard)
    
    html = "<!DOCTYPE html><html><head><title>Wyllene Dynasty</title>"
    html += "<style>body{font-family:Georgia;background:#050510;color:#e0e0e0;padding:30px}"
    html += "h1{color:#D4AF37}h2{color:#D4AF37;margin-top:30px}"
    html += "table{border-collapse:collapse;width:100%;max-width:800px;margin:10px 0}"
    html += "th,td{border:1px solid #222;padding:12px}th{background:#0a0a15;color:#D4AF37}"
    html += "a{color:#D4AF37;text-decoration:none;margin:0 10px}"
    html += ".card{background:#0d0d20;border:1px solid #222;padding:20px;margin:15px 0;border-radius:10px}"
    html += "</style></head><body>"
    html += "<h1>🏰 WYLLENE DYNASTY COMMAND CENTER</h1>"
    html += "<p style='color:#888'>Founded by <b style='color:#D4AF37'>Lunga Titus Malebadi</b> — Founder & CEO</p>"
    html += f"<div class='card'><p>Dynasties: <b>{total_dynasties}</b> | Wealth: <b style='color:#D4AF37'>${total_wealth:,.0f}</b> | Members: <b>{total_members}</b> | Stocks: <b>{len(stocks)}</b></p></div>"
    html += "<h2>🏆 Dynasty Leaderboard</h2><table><tr><th>Rank</th><th>Dynasty</th><th>Wealth</th><th>Score</th></tr>"
    for i, d in enumerate(leaderboard[:10]):
        medals = {0:'🥇',1:'🥈',2:'🥉'}
        rank = medals.get(i, str(i+1))
        html += f"<tr><td>{rank}</td><td>{d['dynasty']}</td><td style='color:#D4AF37'>${d['wealth']:,.0f}</td><td>{d['score']:,}</td></tr>"
    html += "</table>"
    html += "<p><a href='/dynasty'>Create Character</a> | <a href='/market'>Markets</a> | <a href='/protect'>Protection</a> | <a href='/family'>Family</a> | <a href='/wealth'>Wealth</a></p>"
    html += "</body></html>"
    return html

@app.route('/market')
def market_home():
    import market_economy
    economy = market_economy.economy
    market = economy.generate_market_year()
    stocks = economy.get_stock_prices()
    leaderboard = economy.update_leaderboard()
    
    html = "<!DOCTYPE html><html><head><title>Wyllene Markets</title>"
    html += "<style>body{font-family:Georgia;background:#050510;color:#e0e0e0;padding:30px}"
    html += "h1{color:#00ff00}h2{color:#00ff00;margin-top:30px}"
    html += "table{border-collapse:collapse;width:100%;max-width:800px;margin:10px 0}"
    html += "th,td{border:1px solid #222;padding:12px}th{background:#0a0a15;color:#00ff00}"
    html += "a{color:#00ff00;text-decoration:none;margin:0 10px}"
    html += ".card{background:#0d0d20;border:1px solid #222;padding:20px;margin:15px 0;border-radius:10px}"
    html += ".up{color:#4CAF50}.down{color:#F44336}"
    html += "</style></head><body>"
    html += "<h1>📈 WYLLENE MARKETS</h1>"
    html += f"<div class='card'><p>Market: <b>{market['market']}</b> | Growth: <b class='{'up' if market['growth']>0 else 'down'}'>{market['growth']*100:+.1f}%</b> | Volatility: <b>{market['volatility']}</b></p></div>"
    html += "<h2>Stock Prices</h2><table><tr><th>Ticker</th><th>Company</th><th>Price</th><th>Sector</th></tr>"
    for s in stocks:
        color = "up" if s['price'] > 100 else "down"
        html += f"<tr><td><b>{s['ticker']}</b></td><td>{s['name']}</td><td class='{color}'>${s['price']:.2f}</td><td>{s['sector']}</td></tr>"
    html += "</table>"
    html += "<h2>Leaderboard</h2><table><tr><th>Rank</th><th>Dynasty</th><th>Wealth</th><th>Score</th></tr>"
    for i, d in enumerate(leaderboard[:10]):
        html += f"<tr><td>{i+1}</td><td>{d['dynasty']}</td><td style='color:#D4AF37'>${d['wealth']:,.0f}</td><td>{d['score']:,}</td></tr>"
    html += "</table>"
    html += "<p><a href='/market/ipo'>🚀 IPO a Company</a> | <a href='/dashboard'>Dashboard</a></p>"
    html += "</body></html>"
    return html

def start_socket():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((HOST, SOCKET_PORT))
    server.listen(5)
    print(f"🔌 Socket server on port {SOCKET_PORT}")
    while True:
        conn, addr = server.accept()
        threading.Thread(target=handle_client, args=(conn, addr), daemon=True).start()

